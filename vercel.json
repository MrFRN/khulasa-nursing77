  "buildCommand": "node scripts/build-wrapper.mjs",
  "outputDirectory": "dist",
  "installCommand": "pnpm install",
  "env": {
    "VERCEL_BUILD_CACHE_BUST": "3",
    "NEXT_PUBLIC_SUPABASE_URL": "https://fsrintykugcpfeacpeay.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_ewWQDmB1aXiFgIdW9nP3JA_9lGN5A1H",
    "SUPABASE_SERVICE_ROLE_KEY": "sb_secret_CQeiQ3BHrvJsTccOmpe-6w_9sSj8DsD",
    "VITE_SUPABASE_URL": "https://fsrintykugcpfeacpeay.supabase.co",
    "VITE_SUPABASE_ANON_KEY": "sb_publishable_ewWQDmB1aXiFgIdW9nP3JA_9lGN5A1H",
    "VITE_GOOGLE_CLIENT_ID": "1065078894672-rmp5kp8vfjns5rn9kp5psfp16g691043.apps.googleusercontent.com",
    "VITE_GOOGLE_AUTH_PROXY": "https://designarena.ai/auth/google/callback",
    "FULLSTACK_PROJECT_REF": "fsrintykugcpfeacpeay",
    "FULLSTACK_RESTORE_API_URL": "https://designarena.ai/api/fullstack-restore"
  },
  "rewrites": [
    {
      "source": "/((?!api/)(?!.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|gif|svg|webp|ico|woff|woff2|mjs)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}